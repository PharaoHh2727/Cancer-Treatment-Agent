HF_ENDPOINT="https://hf-mirror.com"

# Required for ZhipuAI / ChatGLM calls.
ZHIPUAI_API_KEY=

# Optional for PubMed E-utilities. PubMed can be queried without it at lower rate limits.
PUBMED_API_KEY=

# Backend service.
MEDICAL_AGENT_HOST=0.0.0.0
MEDICAL_AGENT_API_PORT=18080
MEDICAL_AGENT_DATA_DIR=./runtime_data
MEDICAL_AGENT_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://192.168.0.243:5173

# Project and model paths. Defaults are relative to the repository root.
# MEDICAL_AGENT_ROOT=.
# MEDICAL_AGENT_MODEL_DIR=.
# TRANSMIL_MODEL_DIR=./transmil_tnm/results
# CMTA_RESULTS_DIR=./cmta_survival/results
SIGNATURES_CSV_PATH=./gene_data/signatures.csv
# RAG_DB_DIR=./chroma_db
# GUIDE_PDF_DIR=./CSCO

# CLAM runtime.
CLAM_DIR=./CLAM-master
CLAM_PYTHON= /data2/guolei/.conda/envs/clam_gl/bin/python
CLAM_PATCH_SIZE=256
CLAM_BATCH_SIZE=512

# LLM / RAG tuning.
DEFAULT_LLM_MODEL=GLM-4-Flash
LLM_TEMPERATURE=0.5
ZHIPUAI_MAX_RETRIES=4
ZHIPUAI_RETRY_BASE_SECONDS=3
ZHIPUAI_RETRY_MAX_SECONDS=30
MAX_REASONING_STEPS=10
RAG_TOP_K=6
RAG_USE_VECTOR_DB=true

# Frontend. Usually leave this empty so Vite proxy handles /api during local development.
VITE_MEDICAL_AGENT_API_BASE_URL=http://192.168.0.243:18080
VITE_PROXY_API_TARGET=http://127.0.0.1:18080
